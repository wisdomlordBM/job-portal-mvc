 @model List<Jobportalwebsite.Models.ApplicationUser>
@{
    ViewData["Title"] = "Chat";
}
<h2>Chat</h2>
<h4>Chat with other users</h4>

<div class="row">
    <div class="col-md-4">
        <ul class="list-group">
            @foreach (var user in Model)
            {
                var profilePic = !string.IsNullOrEmpty(user.ProfilePicturePath)
                ? user.ProfilePicturePath
                : "/images/anonymous.png";

                if (user.Role == "Jobseeker")
                {
                    <li class="list-group-item user-item d-flex align-items-center" data-userid="@user.UserName">
                        <a asp-controller="Jobseekers" asp-action="Details" asp-route-email="@user.Email" class="me-2">
                            <div style="position: relative; width: 40px; height: 40px;">
                                <img src="@profilePic" class="rounded-circle" style="width: 40px; height: 40px;" />
                                @if (ViewBag.UnreadCounts != null && ViewBag.UnreadCounts.ContainsKey(user.UserName))
                                {
                                    var unread = ViewBag.UnreadCounts[user.UserName];
                                    <span class="badge bg-danger unread-badge">@unread</span>
                                }
                            </div>
                        </a>
                        <div>
                            <strong>@($"{user.FirstName} {user.LastName}")</strong>
                            <div class="text-muted" style="font-size: 0.85rem;">Jobseeker</div>
                        </div>
                    </li>

                 
                }
                else if (user.Role == "Company")
                {
                    <li class="list-group-item user-item d-flex align-items-center" data-userid="@user.UserName">
                        <a asp-controller="Company" asp-action="Details" asp-route-email="@user.Email" class="me-2">
                            <div style="position: relative; width: 40px; height: 40px;">
                                <img src="@profilePic" class="rounded-circle" style="width: 40px; height: 40px;" />
                                @if (ViewBag.UnreadCounts != null && ViewBag.UnreadCounts.ContainsKey(user.UserName))
                                {
                                    var unread = ViewBag.UnreadCounts[user.UserName];
                                    <span class="badge bg-danger unread-badge">@unread</span>
                                }
                            </div>
                        </a>
                        <div>
                            <strong>@user.FirstName</strong> 
                            <div class="text-muted" style="font-size: 0.85rem;">Company</div>
                        </div>
                    </li>
                }
            }
        </ul>
    </div>
    <div class="col-md-8">
        <div id="chatContainer" class="border rounded p-3 d-none">
            <h5 id="chatWithUser">Select a user to start chatting</h5>
            <div id="chatBox" style="height: 600px; overflow-y: auto; margin-bottom: 10px;"></div>

            <div class="input-group">
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message..." disabled />
                <button class="btn btn-primary" id="sendBtn" disabled>Send</button>
            </div>
        </div>
    </div>
</div>

<style>
    .user-item {
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .user-item:hover {
            background-color: #f0f0f0;
        }

        .user-item.active {
            background-color: #007bff;
            color: white;
        }

    #chatBox {
        border: 1px solid #ddd;
        padding: 10px;
        background-color: #f9f9f9;
    }

    .user-item img {
        border: 2px solid #dee2e6;
        object-fit: cover;
    }

    .user-item span {
        font-weight: 500;
    }

    .unread-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        font-size: 0.65rem;
        padding: 4px 6px;
        border-radius: 50%;
    }

</style>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            let selectedUser = null;

            // Handle incoming messages
        
            connection.on("ReceiveMessage", function (fromUser, toUser, message, timestamp) {
                if (selectedUser === fromUser || selectedUser === toUser) {
                    const chatBox = document.getElementById("chatBox");
                    const isCurrentUser = fromUser === "@ViewBag.CurrentUser";
                    const messageDiv = document.createElement("div");
                    messageDiv.className = isCurrentUser ? "message-sent" : "message-received";
                    messageDiv.innerHTML = `
                        <div class="message-content">
                            <strong>${isCurrentUser ? "You" : fromUser}</strong>: ${message}
                            <small class="text-muted">${timestamp}</small>
                        </div>`;
                    chatBox.appendChild(messageDiv);
                    chatBox.scrollTop = chatBox.scrollHeight;
                }
            });

            connection.start().catch(err => console.error("SignalR Connection Error: ", err));

            // Wait for DOM to be ready before attaching click handlers
            document.querySelectorAll(".user-item").forEach(item => {
                item.addEventListener("click", function () {
                    document.querySelectorAll(".user-item").forEach(i => i.classList.remove("active"));
                    this.classList.add("active");

                    selectedUser = this.dataset.userid;
                    document.getElementById("chatWithUser").textContent = `Chat with ${this.textContent}`;
                    document.getElementById("chatContainer").classList.remove("d-none");
                    document.getElementById("messageInput").disabled = false;
                    document.getElementById("sendBtn").disabled = false;

                    // Remove unread badge when user is clicked
                    const badge = this.querySelector(".unread-badge");
                    if (badge) {
                        badge.remove();
                    }

                    // Fetch chat history
                    fetch(`/Chat/GetChatHistory?withUser=${selectedUser}`)
                        .then(response => response.text())
                        .then(html => {
                            document.getElementById("chatBox").innerHTML = html;
                            document.getElementById("chatBox").scrollTop = document.getElementById("chatBox").scrollHeight;
                        })
                        .catch(err => console.error("Fetch Chat History Error: ", err));
                });

               
            });

            document.getElementById("sendBtn").addEventListener("click", function () {
                const message = document.getElementById("messageInput").value.trim();
                if (selectedUser && message) {
                    connection.invoke("SendMessage", selectedUser, message)
                        .catch(err => console.error("Send Message Error: ", err));
                    document.getElementById("messageInput").value = "";
                }
            });
        });
    </script>
}
