@model IEnumerable<Job>
@{
    Layout = "~/Views/Shared/_Admin.cshtml";
    ViewData["Title"] = "Manage Job Listings";
}

<div class="container">
    <h3 class="mb-4">Manage Job Listings</h3>

    @foreach (var job in Model)
    {
        var logoPath = string.IsNullOrEmpty(job.Company?.ProfilePicturePath)
        ? "/images/default-company-logo.png"
        : job.Company.ProfilePicturePath;

        <div class="card mb-3 shadow-sm rounded-4">
            <div class="card-body d-flex gap-3">
                <img src="@logoPath" style="width:56px;height:56px;object-fit:cover;border-radius:10px;" alt="@job.Company?.Name" />

                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap">
                        <div>
                            <h5 class="mb-1">@job.JobTitle</h5>
                            <div class="text-muted small mb-2">
                                @job.Company?.Name · @job.Location
                            </div>
                        </div>
                        <div class="text-end">
                            @switch (job.PostStatus)
                            {
                                case JobPostStatus.Pending:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                                case JobPostStatus.Posted:
                                    <span class="badge bg-success">Posted</span>
                                    break;
                                case JobPostStatus.Declined:
                                    <span class="badge bg-danger">Declined</span>
                                    break;
                            }
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-3 mb-2 small">
                        <span><strong>Type:</strong> @job.EmploymentType</span>
                        <span><strong>Salary:</strong> @Jobportalwebsite.Helper.SalaryFormatter.Format(job.Salary, job.Company?.Country?.Currency?.Symbol, job.SalaryPeriod)</span>
                        <span><strong>Posted:</strong> @job.DatePosted.ToString("MMM dd, yyyy")</span>
                        <span><strong>Applicants:</strong> @job.ApplicantCount</span>
                    </div>
                    @if (job.PostStatus == JobPostStatus.Pending)
                    {
                        <div class="d-flex gap-2">
                            <form asp-action="ApproveJob" asp-controller="Admin" method="post" asp-route-id="@job.Id">
                                <button type="submit" class="btn btn-success btn-sm">Approve</button>
                            </form>
                            <form asp-action="DeclineJob" asp-controller="Admin" method="post" asp-route-id="@job.Id">
                                <button type="submit" class="btn btn-danger btn-sm">Decline</button>
                            </form>
                        </div>
                    }
                    else if (job.PostStatus == JobPostStatus.Posted)
                    {
                        <span class="text-muted small">Already posted</span>
                    }
                    else
                    {
                        <span class="text-muted small">Declined</span>
                    }
                </div>
            </div>
        </div>
    }
</div>