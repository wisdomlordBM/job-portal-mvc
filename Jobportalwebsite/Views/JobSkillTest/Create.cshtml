
@model List<JobSkillTest>

@{
    // Optionally specify a layout if needed, e.g.: Layout = "~/Views/Shared/_Layout.cshtml";
    int totalQuestions = 5;
}
@{
    Layout = "~/Views/Shared/_Company.cshtml";
}
<!-- Bootstrap CSS (via CDN) -->
<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

<div class="container">
    <div class="row justify-content-center">
        <!-- Adjust the column width (col-md-8 col-lg-6) as needed -->
        <div class="col-md-8 col-lg-6">
            <form method="post" id="questionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="jobId" value="@ViewBag.JobId" />

                <div id="questionCards">
                    @for (int i = 0; i < totalQuestions; i++)
                    {
                        <div class="card question-card" data-index="@i" style="display:@(i == 0 ? "block" : "none"); margin-top:20px;">
                            <div class="card-header">
                                Question @(i + 1) of @totalQuestions
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label>Question</label>
                                    <input type="text" name="questions[@i].Question" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Option A</label>
                                    <input type="text" name="questions[@i].OptionA" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Option B</label>
                                    <input type="text" name="questions[@i].OptionB" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Option C</label>
                                    <input type="text" name="questions[@i].OptionC" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Option D</label>
                                    <input type="text" name="questions[@i].OptionD" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label>Correct Answer (A/B/C/D)</label>
                                    <input type="text" name="questions[@i].CorrectAnswer" class="form-control" required />
                                </div>
                            </div>
                            <div class="card-footer text-right">
                                @if (i > 0)
                                {
                                    <button type="button" class="btn btn-secondary prev-btn">Previous</button>
                                }
                                @if (i < totalQuestions - 1)
                                {
                                    <button type="button" class="btn btn-primary next-btn">Next</button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-success">Submit</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>
</div>
 
<!-- jQuery (via CDN) -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<!-- Optional: Bootstrap JS (if you need any Bootstrap JS functionality) -->
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    $(document).ready(function () {
        $('.next-btn').click(function () {
            var currentCard = $(this).closest('.question-card');
            var currentIndex = parseInt(currentCard.attr('data-index'));
            var nextIndex = currentIndex + 1;
            // Hide current card and show the next one
            currentCard.hide();
            $('.question-card[data-index="' + nextIndex + '"]').show();
        });

        $('.prev-btn').click(function () {
            var currentCard = $(this).closest('.question-card');
            var currentIndex = parseInt(currentCard.attr('data-index'));
            var prevIndex = currentIndex - 1;
            // Hide current card and show the previous one
            currentCard.hide();
            $('.question-card[data-index="' + prevIndex + '"]').show();
        });
    });
</script>
 
