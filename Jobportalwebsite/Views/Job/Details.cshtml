@model Jobportalwebsite.Models.Job

@{
    var logoPath = string.IsNullOrEmpty(Model.Company?.ProfilePicturePath)
        ? "/images/default-company-logo.png"
        : Model.Company.ProfilePicturePath;
}

<div class="container my-5" style="max-width: 800px;">
    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex gap-3 align-items-start">
            <img src="@logoPath" alt="@Model.Company?.Name" style="width:72px;height:72px;object-fit:cover;border-radius:12px;" />
            <div class="flex-grow-1">
                <h2 class="mb-1">@Model.JobTitle</h2>
                <div class="text-muted mb-2">
                    @Model.Company?.Name
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span> · @Model.Location</span>
                    }
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge job-badge">@Model.EmploymentType</span>
                    <span class="badge job-badge">
                        @Jobportalwebsite.Helper.SalaryFormatter.Format(Model.Salary, Model.Company?.Country?.Currency?.Symbol, Model.SalaryPeriod)
                    </span>
                    <span class="badge job-badge">Posted @Model.DatePosted.ToString("MMM dd, yyyy")</span>
                    <span class="badge job-badge">
                        <i class="bi bi-people"></i> @Model.ApplicantCount applicant@(Model.ApplicantCount == 1 ? "" : "s")
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <h5 class="mb-3">Job Description</h5>
        <p style="white-space: pre-line;">@Model.Description</p>

        @if (!string.IsNullOrEmpty(Model.RequiredSkills))
        {
            <h6 class="mt-4 mb-2">Required Skills</h6>
            <p>@Model.RequiredSkills</p>
        }
    </div>

    <div class="card shadow-sm rounded-4 p-4 mb-4">
        <h5 class="mb-3">About @Model.Company?.Name</h5>
        <p class="mb-2">@Model.Company?.Description</p>
        @if (!string.IsNullOrEmpty(Model.Company?.WebsiteUrl))
        {
            <a href="@Model.Company.WebsiteUrl" target="_blank">Visit website</a>
        }
    </div>

    <div class="d-flex gap-2">
        <a asp-controller="Jobseekers" asp-action="Create" asp-route-jobId="@Model.Id" class="btn btn-success btn-lg">
            Apply for this Job
        </a>
        <a asp-controller="Job" asp-action="Index" class="btn btn-outline-secondary btn-lg">
            Back to Listings
        </a>
    </div>
</div>

<style>
    .job-badge {
        background: #eef2f5;
        color: #495057;
        font-weight: 500;
        padding: 6px 12px;
    }
</style>

