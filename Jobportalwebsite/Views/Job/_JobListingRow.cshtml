@model Jobportalwebsite.Models.Job

@{
    var logoPath = string.IsNullOrEmpty(Model.Company?.ProfilePicturePath)
        ? "/images/default-company-logo.png"
        : Model.Company.ProfilePicturePath;
    var description = Model.Description ?? string.Empty;
    var snippet = description.Length > 160 ? description.Substring(0, 160) + "…" : description;
}

<div class="job-row card mb-3">
    <div class="card-body d-flex gap-3">
        <img src="@logoPath" alt="@Model.Company?.Name" class="job-row-logo" />

        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start flex-wrap">
                <div>
                    <a asp-controller="Job" asp-action="Details" asp-route-id="@Model.Id" class="job-row-title">
                        @Model.JobTitle
                    </a>
                    <div class="text-muted small">
                        @Model.Company?.Name
                        @if (!string.IsNullOrEmpty(Model.Location))
                        {
                            <span> · @Model.Location</span>
                        }
                    </div>
                </div>
                <div class="text-end">
                    <div class="fw-semibold">
                        @Jobportalwebsite.Helper.SalaryFormatter.Format(Model.Salary, Model.Company?.Country?.Currency?.Symbol, Model.SalaryPeriod)
                    </div>
                    <div class="text-muted small">@Model.DatePosted.ToString("MMM dd, yyyy")</div>
                </div>
            </div>

            <p class="job-row-description mt-2 mb-2">@snippet</p>
            <div class="d-flex align-items-center gap-2">
                <span class="badge job-badge">@Model.EmploymentType</span>
                <span class="badge job-badge">
                    <i class="bi bi-people"></i> @Model.ApplicantCount applicant@(Model.ApplicantCount == 1 ? "" : "s")
                </span>
                <a asp-controller="Job" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-success ms-auto">
                    View Details
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .job-row-logo {
        width: 56px;
        height: 56px;
        object-fit: cover;
        border-radius: 10px;
        flex-shrink: 0;
        background: #f1f3f5;
    }

    .job-row-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #1a1a1a;
        text-decoration: none;
    }

        .job-row-title:hover {
            color: #198754;
            text-decoration: underline;
        }

    .job-row-description {
        color: #4a4a4a;
        font-size: 0.92rem;
    }

    .job-badge {
        background: #eef2f5;
        color: #495057;
        font-weight: 500;
        padding: 5px 10px;
    }

    .job-row {
        border: 1px solid #e9ecef;
        border-radius: 12px;
        transition: box-shadow 0.15s ease;
    }

        .job-row:hover {
            box-shadow: 0 4px 14px rgba(0,0,0,0.06);
        }
</style>
