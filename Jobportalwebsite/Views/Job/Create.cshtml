@model Jobportalwebsite.Models.Job

<div class="container mt-5">
    <h1 class="text-center text-primary mb-4">Create Job Listing</h1>

    <div class="card shadow-lg p-3" style="max-width: 600px; margin: 0 auto;">
        <div class="card-body">
            <form asp-action="CreateJob" method="post" enctype="multipart/form-data">
                <!-- Hidden CompanyId -->
                <input type="hidden" asp-for="CompanyId" value="@ViewBag.CompanyId" />

                <!-- Job Title -->
                <div class="form-group mb-3">
                    <label for="JobTitle" class="form-label fw-bold">Job Title</label>
                    <input asp-for="JobTitle" class="form-control" placeholder="Enter the job title" required />
                    <span asp-validation-for="JobTitle" class="text-danger"></span>
                </div>

                <!-- Job Description -->
                <div class="form-group mb-3">
                    <label for="Description" class="form-label fw-bold">Job Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter a detailed job description" required></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Job Location -->
                <div class="form-group mb-3">
                    <label for="Location" class="form-label fw-bold">Job Location</label>
                    <input asp-for="Location" class="form-control" placeholder="Enter the job location" required />
                    <span asp-validation-for="Location" class="text-danger"></span>
                </div>

                <!-- Employment Type -->
                <div class="form-group mb-3">
                    <label for="EmploymentType" class="form-label fw-bold">Employment Type</label>
                    <select asp-for="EmploymentType" class="form-control" required>
                        <option value="">Select Employment Type</option>
                        <option value="Full-time">Full-time</option>
                        <option value="Part-time">Part-time</option>
                        <option value="Contract">Contract</option>
                        <option value="Internship">Internship</option>
                    </select>
                    <span asp-validation-for="EmploymentType" class="text-danger"></span>
                </div>

                <!-- Salary -->
                <div class="form-group mb-3">
                    <label for="Salary" class="form-label fw-bold">Salary</label>
                    <input asp-for="Salary" class="form-control" type="number" step="0.01" placeholder="Enter salary" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="SalaryPeriod" class="form-label fw-bold">Salary Period</label>
                    <select asp-for="SalaryPeriod" class="form-control" id="salaryPeriod" required>
                        <option value="">Select salary period</option>
                        <option value="PerHour">Per Hour</option>
                        <option value="PerDay">Per Day</option>
                        <option value="PerWeek">Per Week</option>
                        <option value="PerMonth">Per Month</option>
                        <option value="PerYear">Per Year</option>
                        <option value="Contract">Contract</option>
                        <option value="Negotiable">Negotiable</option>
                    </select>
                    <span asp-validation-for="SalaryPeriod" class="text-danger"></span>
                </div>

                <!-- Image URL -->
                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Company / Job Image</label>

                    <input type="file"
                           name="imageFile"
                           id="imageFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp" />

                    <img id="previewImage"
                         src="#"
                         style="display:none;max-width:100%;margin-top:15px;border-radius:10px;" />
                </div>

                <!-- Submit Button -->
                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-success btn-lg">Create Job</button>
                </div>

                <!-- Back Button -->
                <div class="d-grid mt-3">
                    <a asp-controller="Job" asp-action="Index" class="btn btn-secondary btn-sm">Back to Job Listings</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const salaryPeriod = document.getElementById('salaryPeriod');
    const salary = document.getElementById('Salary');

    function updateSalaryInput() {
        const isNegotiable = salaryPeriod.value === 'Negotiable';
        salary.disabled = isNegotiable;
        salary.required = !isNegotiable;
        if (isNegotiable) salary.value = '';
    }

    salaryPeriod.addEventListener('change', updateSalaryInput);
    updateSalaryInput();
</script>
<script>
    const imageInput = document.getElementById("imageFile");
    const preview = document.getElementById("previewImage");

    imageInput.addEventListener("change", function () {

        if (this.files.length > 0) {

            const reader = new FileReader();

            reader.onload = function (e) {
                preview.src = e.target.result;
                preview.style.display = "block";
            };

            reader.readAsDataURL(this.files[0]);
        }

    });
</script>










