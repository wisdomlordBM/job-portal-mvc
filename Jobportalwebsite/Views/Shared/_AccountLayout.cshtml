<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] CareerNest</title>
    <link rel="icon" type="image/jpeg" href="~/images/icon1.png" />
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#12bcaa">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Jobportalwebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg" style="background-color: #12bcaa;" data-bs-theme="dark">
            <div class="container-fluid">
                <a asp-controller="Home" asp-action="Index" class="d-flex align-items-center text-decoration-none">
                    <img src="~/images/icon1.jpg" alt="CareerNest" width="50" height="50" style="border-radius:50%; object-fit: cover;">
                    <span class="navbar-brand ms-2 mb-0">CareerNest</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="true" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse show" id="navbarColor01">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            <span class="visually-hidden">(current)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer text-muted bg-dark">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <h5 class="text-white">About CareerNest</h5>
                    <p style="font-size: 14px;" class="text-white-50">Your trusted platform for job opportunities and career advancement. Join a growing community of job seekers and employers today.</p>
                    <p style="font-size: 14px;" class="text-white-50">Email: support@careernest.com</p>
                    <p style="font-size: 14px;" class="text-white-50">Phone: +1-555-0100</p>
                </div>
                <div class="col-12 col-md-4 footer-links">
                    <h5 class="text-white">Quick Links</h5>
                    <ul class="list-unstyled" style="font-size: 14px;">
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/jobs">Browse Jobs</a></li>
                        <li><a href="/employer/register">Post a Job</a></li>
                    </ul>
                </div>
                <div class="col-12 col-md-4">
                    <h5 class="text-white">Stay Connected</h5>
                    <p style="font-size: 14px;" class="text-white-50">Follow us on social media for updates and job tips.</p>
                    <a href="#" class="text-white"><i class="fab fa-facebook-f me-3"></i></a>
                    <a href="#" class="text-white"><i class="fab fa-twitter me-3"></i></a>
                    <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <hr class="border-secondary">
            <p class="text-center text-white-50" style="font-size: 14px;">&copy; @DateTime.UtcNow.Year CareerNest. All Rights Reserved.</p>
            <p class="text-center" style="font-size: 14px;">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white-50">Privacy</a>
            </p>
        </div>
    </footer>
    <div class="modal fade" id="notificationsModal" tabindex="-1" aria-labelledby="notificationsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="notificationsModalLabel">Notifications</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <ul id="notificationList" class="list-group">
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>