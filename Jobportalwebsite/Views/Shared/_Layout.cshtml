<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] CareerNest</title>
    <link rel="icon" type="image/jpeg" href="~/images/icon1.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/bootstrap (4).css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Jobportalwebsite.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <style>
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(255, 255, 255, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }
    </style>
</head>
<body>
    <div class="loading-overlay" id="loadingScreen">
        <img src="~/images/icon1.jpg" alt="Loading..." />
    </div>
    <div id="loading-area">
        <div class="loading-spinner">
            <div class="spinner-circle"></div>
            <div class="spinner-circle"></div>
            <div class="spinner-circle"></div>
            <div class="spinner-circle"></div>
        </div>
        <div class="load-text">
            <span class="text-load">L</span>
            <span class="text-load">O</span>
            <span class="text-load">A</span>
            <span class="text-load">D</span>
            <span class="text-load">I</span>
            <span class="text-load">N</span>
            <span class="text-load">G</span>
        </div>
    </div>
    <header>
        <nav class="navbar navbar-expand-lg" style="background-color: #12bcaa;" data-bs-theme="dark">
            <div class="container-fluid">
                <img src="~/images/icon1.jpg" alt="Logo" width="70" height="50" style="border-radius: 50%;">
                <a class="navbar-brand" href="#">CareerNest</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarColor01">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Blog")">Blog</a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                            </li>
                            <li class="nav-item">
                                @{
                                    var roleToUrlMapping = new Dictionary<string, string>
                            {
                            { "Admin", Url.Action("Index", "Admin") },
                            { "Jobseeker", Url.Action("Index", "Job") },
                            { "Company", Url.Action("Index", "Company") }
                            };
                                    var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value;
                                    var dashboardUrl = roleToUrlMapping.ContainsKey(userRole ?? string.Empty)
                                    ? roleToUrlMapping[userRole]
                                    : Url.Action("Index", "Home");
                                }
                                <a class="nav-link" href="@dashboardUrl">Dashboard</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="CompanyRegister">Create Company</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer text-muted bg-dark">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4">
                    <h5 class="text-white">About CareerNest</h5>
                    <p style="font-size: 14px;" class="text-white-50">Your trusted platform for job opportunities and career advancement. Join a growing community of job seekers and employers today.</p>
                    <p style="font-size: 14px;" class="text-white-50">Email: support@careernest.com</p>
                    <p style="font-size: 14px;" class="text-white-50">Phone: +1-555-0100</p>
                </div>

                <div class="col-md-4 footer-links">
                    <h5 class="text-white">Quick Links</h5>
                    <ul class="list-unstyled" style="font-size: 14px;">
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/jobs">Browse Jobs</a></li>
                        <li><a href="/employer/register">Post a Job</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="text-white">Stay Connected</h5>
                    <p style="font-size: 14px;" class="text-white-50">Follow us on social media for updates and job tips.</p>
                    <a href="#" class="text-white"><i class="fab fa-facebook-f me-3"></i></a>
                    <a href="#" class="text-white"><i class="fab fa-twitter me-3"></i></a>
                    <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <hr class="border-secondary">
            <p class="text-center text-white-50" style="font-size: 14px;">&copy; @DateTime.Now.Year CareerNest. All Rights Reserved.</p>
            <p class="text-center" style="font-size: 14px;">
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-white-50">Privacy</a>
            </p>
        </div>
    </footer>
    <div class="modal fade" id="notificationsModal" tabindex="-1" aria-labelledby="notificationsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="notificationsModalLabel">Notifications</h5>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <ul id="notificationList" class="list-group">
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            $.get('/Notification/GetMyNotificationCount', function (data) {
                $('#notificationCount').text(data);
            });
            $('#notificationsModal').on('show.bs.modal', function () {
                $.get('/Notification/GetMyNotifications', function (notifications) {
                    let notificationList = $('#notificationList');
                    notificationList.empty();
                    if (notifications.length === 0) {
                        notificationList.append('<li class="list-group-item text-muted">No new notifications.</li>');
                    } else {
                        notifications.forEach(function (notification) {
                            notificationList.append('<li class="list-group-item">' + notification.message + '</li>');
                        });
                    }
                });
            });
        });
    </script>
    <script>
        window.addEventListener('load', function () {
            setTimeout(function() {
                document.getElementById('loading-area').style.opacity = '0';
            }, 2000);

            setTimeout(function() {
                document.getElementById('loading-area').style.display = 'none';
            }, 3000);
        });
    </script>
    <script>
        window.addEventListener('load', function() {
            document.getElementById('loadingScreen').style.display = 'none';
        });
    </script>
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("ReceiveNotification", function (message) {
            alert("New Notification: " + message);
        });

        connection.start().catch(function (err) {
            console.error(err.toString());
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>