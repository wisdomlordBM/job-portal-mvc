<div class="container my-5">
    <h2 class="text-center text-primary mb-4">Discover Your Next Career Opportunity</h2>

    @if (Model != null && Model.Count > 0)
    {
        <div id="jobCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var job = Model[i];
                    var logoPath = string.IsNullOrEmpty(job.Company?.ProfilePicturePath)
                    ? "/images/default-company-logo.png"
                    : job.Company.ProfilePicturePath;

                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="d-flex justify-content-center">
                            <div class="card shadow-sm rounded-4" style="max-width: 650px; width: 100%;">
                                <div class="card-body d-flex gap-3">
                                    <img src="@logoPath" alt="@job.Company?.Name" style="width:64px;height:64px;object-fit:cover;border-radius:10px;flex-shrink:0;" />
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1">@job.JobTitle</h5>
                                        <div class="text-muted small mb-2">
                                            @job.Company?.Name
                                            @if (!string.IsNullOrEmpty(job.Location))
                                            {
                                                <span> · @job.Location</span>
                                            }
                                        </div>
                                        <p class="mb-2" style="font-size: 0.92rem; color: #4a4a4a;">
                                            @{
                                                var desc = job.Description ?? string.Empty;
                                                var snippet = desc.Length > 140 ? desc.Substring(0, 140) + "…" : desc;
                                            }
                                            @snippet
                                        </p>
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <span class="badge" style="background:#eef2f5;color:#495057;">@job.EmploymentType</span>
                                            <span class="badge" style="background:#eef2f5;color:#495057;">
                                                @Jobportalwebsite.Helper.SalaryFormatter.Format(job.Salary, job.Company?.Country?.Currency?.Symbol, job.SalaryPeriod)
                                            </span>
                                        </div>
                                        <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-success btn-sm">
                                            View Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#jobCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#jobCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">No jobs available at the moment.</p>
    }
</div>
