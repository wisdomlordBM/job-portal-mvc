@model List<Job>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Home Page";
}

<style>
    .hero-carousel .carousel-item img {
        height: 60vh;
        object-fit: cover;
    }

    @@media (max-width: 768px) {
        .hero-carousel .carousel-item img {
            height: 40vh;
        }

        .hero-carousel .display-4 {
            font-size: 1.6rem;
        }

        .hero-carousel .lead {
            font-size: 0.95rem;
        }
    }

    .footer-links a {
        color: #12bcaa;
        text-decoration: none;
    }

        .footer-links a:hover {
            text-decoration: underline;
        }

    /* ---- Shared section styling ---- */
    .section-eyebrow {
        color: #12bcaa;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .why-card {
        background: #fff;
        border: 1px solid #eef0f2;
        border-radius: 16px;
        padding: 2rem 1.5rem;
        height: 100%;
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    }

        .why-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 28px rgba(18,188,170,0.15);
            border-color: #12bcaa;
        }

    .why-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: rgba(18,188,170,0.1);
        color: #12bcaa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 1rem auto;
    }

    .features-section {
        position: relative;
        overflow: hidden;
    }

    .feature-card {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 16px;
        padding: 1.75rem 1.5rem;
        height: 100%;
        transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
    }

        .feature-card:hover {
            transform: translateY(-6px);
            background: rgba(18,188,170,0.1);
            box-shadow: 0 10px 25px rgba(0,0,0,0.35);
        }

    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #12bcaa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: #fff;
    }

    .floating-img-wrap {
        position: relative;
        display: inline-block;
    }

    .floating-img {
        animation: floatY 4s ease-in-out infinite;
        max-width: 100%;
    }

    @@keyframes floatY {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-14px);
        }
    }

    .badge-pop {
        position: absolute;
        bottom: 10px;
        right: -10px;
        background: #12bcaa;
        color: #fff;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        box-shadow: 0 6px 16px rgba(0,0,0,0.3);
        animation: popIn 0.6s ease 0.8s both, floatY 4s ease-in-out infinite;
    }

    @@keyframes popIn {
        0% {
            transform: scale(0);
            opacity: 0;
        }

        70% {
            transform: scale(1.15);
            opacity: 1;
        }

        100% {
            transform: scale(1);
        }
    }

    /* Employer section */
    .employer-card {
        background: #fff;
        border-radius: 20px;
        padding: 2.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    }

    .stat-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(18,188,170,0.1);
        color: #0d8f83;
        padding: 0.5rem 1rem;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    /* Final CTA */
    .cta-section {
        background: linear-gradient(135deg, #12bcaa 0%, #0d8f83 100%);
        border-radius: 24px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }

        .cta-section::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.08);
            border-radius: 50%;
            top: -100px;
            right: -100px;
        }

        .cta-section::after {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            background: rgba(255,255,255,0.06);
            border-radius: 50%;
            bottom: -80px;
            left: -60px;
        }

    #jobCarousel {
        background-color: #e0e0e0;
    }

    .carousel-control-prev-icon,
    .carousel-control-next-icon {
        background-color: #000;
        border-radius: 50%;
        padding: 10px;
    }

    .carousel-control-prev,
    .carousel-control-next {
        filter: invert(1);
    }

    /* Scroll reveal */
    .reveal {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.6s ease, transform 0.6s ease;
    }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

    @@media (max-width: 768px) {
        .badge-pop {
            right: 8px;
            bottom: -12px;
            font-size: 0.7rem;
            padding: 0.4rem 0.8rem;
        }

        .employer-card {
            padding: 1.5rem;
        }
    }
</style>

<div id="demo" class="carousel slide carousel-fade hero-carousel" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#demo" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#demo" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#demo" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/images/freepik__upload__51312.jpeg" alt="Find Your Dream Job" class="d-block w-100" loading="lazy">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center text-white h-100">
                <h1 class="display-4 fw-bold">
                    <i class="fa fa-briefcase" style="color:#12bcaa;"></i>
                    Find Your Dream Job Today!
                </h1>
                <p class="lead mt-3">
                    Explore top job opportunities. Register your company or apply for your next big career move with ease.
                </p>
                <div class="mt-3">
                    <a class="btn btn-primary btn-lg" style="background-color:#12bcaa;border:none;" asp-controller="Account" asp-action="Login">Browse Jobs</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Register">Register Now</a>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/coins-job-word.jpg" alt="Build Your Career" class="d-block w-100" loading="lazy">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center text-white h-100">
                <h1 class="display-4 fw-bold">Unlock Your Career Potential!</h1>
                <p class="lead mt-3">Create a profile and get matched with jobs tailored to your skills and interests.</p>
                <div class="mt-3">
                    <a class="btn btn-outline-light btn-lg" style="background-color:#12bcaa;border:none;" asp-controller="Account" asp-action="Register">Create Profile</a>
                </div>
            </div>
        </div>

        <div class="carousel-item">
            <img src="~/images/hul.jpg" alt="Hire Top Talent" class="d-block w-100" loading="lazy">
            <div class="carousel-caption d-flex flex-column justify-content-center align-items-center text-white h-100">
                <h1 class="display-4 fw-bold">Hire the Best Talent!</h1>
                <p class="lead mt-3">Post job listings and connect with skilled professionals. Build your team for success.</p>
                <div class="mt-3">
                    <a class="btn btn-primary btn-lg" style="background-color:#12bcaa;border:none;" asp-controller="Account" asp-action="CompanyRegister">Post a Job</a>
                </div>
            </div>
        </div>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#demo" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#demo" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>
</div>

<!-- Why CareerNest -->
<div class="container my-5 py-3">
    <div class="text-center mb-5 reveal">
        <div class="section-eyebrow">Why CareerNest</div>
        <h2 class="fw-bold">Everyone finds their fit here</h2>
    </div>
    <div class="row g-4 text-center">
        <div class="col-12 col-md-4 reveal">
            <div class="why-card">
                <div class="why-icon"><i class="bi bi-house-fill"></i></div>
                <h5>Work From Home</h5>
                <p class="text-muted mb-0">Flexible schedules and remote roles from companies hiring worldwide, right now.</p>
            </div>
        </div>
        <div class="col-12 col-md-4 reveal" style="transition-delay:0.1s;">
            <div class="why-card">
                <div class="why-icon"><i class="bi bi-buildings-fill"></i></div>
                <h5>Work From Office</h5>
                <p class="text-muted mb-0">Connect with employers near you and explore in-office opportunities that fit your goals.</p>
            </div>
        </div>
        <div class="col-12 col-md-4 reveal" style="transition-delay:0.2s;">
            <div class="why-card">
                <div class="why-icon"><i class="bi bi-building-fill-add"></i></div>
                <h5>Company Registration</h5>
                <p class="text-muted mb-0">Register your company and get instant access to a vast pool of qualified candidates.</p>
            </div>
        </div>
    </div>
</div>

<!-- Feature highlight with floating image -->
<div class="container-fluid p-4 p-md-5 my-5 bg-dark text-white features-section">
    <div class="row g-4 align-items-center">
        <div class="col-12 col-md-7">
            <div class="row g-4">
                <div class="col-12 col-sm-6 reveal">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <h4 class="mt-3">Fast, Simple Applications</h4>
                        <p class="text-white-50">
                            Create a profile once and apply to roles in a couple of clicks — no repeated forms.
                        </p>
                    </div>
                </div>
                <div class="col-12 col-sm-6 reveal" style="transition-delay: 0.15s;">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-bell-fill"></i>
                        </div>
                        <h4 class="mt-3">Stay Ahead with Job Alerts</h4>
                        <p class="text-white-50">
                            Get personalized job alerts based on your experience, industry, and location preferences.
                        </p>
                    </div>
                </div>
            </div>
            <a class="btn btn-outline-light btn-lg mt-4 reveal" style="transition-delay: 0.3s;" asp-controller="Account" asp-action="Register">
                Get Started <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="col-12 col-md-5 text-center reveal" style="transition-delay: 0.2s;">
            <div class="floating-img-wrap">
                <img src="~/images/img1.jpeg" class="img-fluid rounded-4 shadow floating-img" alt="Work from Home" />
                <span class="badge-pop">
                    <i class="bi bi-lightning-charge-fill"></i> Live Openings Daily
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Latest jobs carousel -->
<div class="container my-5">
    <div class="text-center mb-4 reveal">
        <div class="section-eyebrow">Fresh Off the Board</div>
        <h2 class="fw-bold text-dark">Discover Your Next Career Opportunity</h2>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div id="jobCarousel" class="carousel slide reveal" data-bs-ride="carousel" data-bs-interval="4000">
            <div class="carousel-inner">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var job = Model[i];
                    var logoPath = string.IsNullOrEmpty(job.Company?.ProfilePicturePath)
                    ? "/images/default-company-logo.png"
                    : job.Company.ProfilePicturePath;

                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="d-flex justify-content-center px-2">
                            <div class="card shadow-sm rounded-4 w-100" style="max-width: 650px;">
                                <div class="card-body d-flex flex-column flex-sm-row gap-3">
                                    <img src="@logoPath" alt="@job.Company?.Name" style="width:64px;height:64px;object-fit:cover;border-radius:10px;flex-shrink:0;" />
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1">@job.JobTitle</h5>
                                        <div class="text-muted small mb-2">
                                            @job.Company?.Name
                                            @if (!string.IsNullOrEmpty(job.Location))
                                            {
                                                <span> · @job.Location</span>
                                            }
                                        </div>
                                        <p class="mb-2" style="font-size: 0.92rem; color: #4a4a4a;">
                                            @{
                                                var desc = job.Description ?? string.Empty;
                                                var snippet = desc.Length > 140 ? desc.Substring(0, 140) + "…" : desc;
                                            }
                                            @snippet
                                        </p>
                                        <div class="d-flex flex-wrap gap-2 mb-3">
                                            <span class="badge" style="background:#eef2f5;color:#495057;">@job.EmploymentType</span>
                                            <span class="badge" style="background:#eef2f5;color:#495057;">
                                                @Jobportalwebsite.Helper.SalaryFormatter.Format(job.Salary, job.Company?.Country?.Currency?.Symbol, job.SalaryPeriod)
                                            </span>
                                        </div>
                                        <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-success btn-sm">View Details</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#jobCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#jobCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    }
    else
    {
        <p class="text-center text-muted">No jobs available at the moment.</p>
    }
</div>

<!-- For Employers -->
<div class="container my-5">
    <div class="employer-card reveal">
        <div class="row g-4 align-items-center">
            <div class="col-12 col-md-6">
