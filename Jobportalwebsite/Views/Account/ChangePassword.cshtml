@model Jobportalwebsite.Viewmodel.ChangePasswordViewModel
@{
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    ViewData["Title"] = "Change Password";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; padding-top: 50px;">
    <div class="card shadow-lg" style="width: 32rem; border-radius: 20px;">
        <div class="card-body p-5">
            <h2 class="card-title text-center mb-4">
                @(Model.HasExistingPassword ? "Change Password" : "Set a Password")
            </h2>

            @if (!Model.HasExistingPassword)
            {
                <p class="text-muted text-center mb-4">
                    You signed in with a social account and don't have a password yet. Set one below so you can also log in with your email.
                </p>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                @if (Model.HasExistingPassword)
                {
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" />
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" />
                </div>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary">Save Password</button>
                </div>
            </form>
        </div>
    </div>
</div>